            msg_type = get_msg_type_dinspec(str(faulty_request))
            msg_namespace = Namespace.DIN_MSG_DEF
        elif isinstance(faulty_request, V2GMessageV20):
            msg_type = type(faulty_request)
            msg_namespace = Namespace.ISO_V20_BASE
