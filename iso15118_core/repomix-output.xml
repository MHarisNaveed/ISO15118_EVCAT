    SESSION_SETUP_REQ = 2
    SERVICE_DISCOVERY_REQ = 2
    SERVICE_DETAIL_REQ = 5
    PAYMENT_SERVICE_SELECTION_REQ = 2
    CERTIFICATE_INSTALLATION_REQ = 5
