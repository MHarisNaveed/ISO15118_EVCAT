                    self.min_v2x_energy_request = (
                        params.ev_min_v2x_energy_request.get_decimal_value()
                    )  # noqa: E501

                self._update_common_acbpt_limits(ac_limits, params)
        else:
            raise UnknownEnergyService(f"Unknown Service {energy_service}")

