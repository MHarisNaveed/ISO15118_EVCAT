    async def get_dc_ev_power_delivery_parameter_dinspec(
        self,
    ) -> DCEVPowerDeliveryParameterDINSPEC:
        raise NotImplementedError(
            "DIN SPEC 70121 is not supported by RealBatterySimulator"
        )
    
