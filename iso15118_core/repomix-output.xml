				<xs:element name="AbsolutePriceSchedule" type="AbsolutePriceScheduleType"/>
				<xs:element name="PriceLevelSchedule" type="PriceLevelScheduleType"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
